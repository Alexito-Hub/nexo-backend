# Copia este archivo a `.env` y completa los valores.
# `.env` NO se versiona: contiene secretos.

# Cadena de conexión de MongoDB (Atlas o local).
MONGODB_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/nexo?appName=Cluster0

# Base separada para los tests. Debe apuntar a una base distinta: la suite
# borra sus colecciones en cada corrida.
MONGODB_URI_TEST=mongodb+srv://usuario:clave@cluster.mongodb.net/nexo_test?appName=Cluster0

# Clave del área de administración (cabecera `x-admin-key`).
# En producción usa un valor largo y aleatorio: `openssl rand -base64 32`.
ADMIN_API_KEY=cambia-esta-clave

# Solo producción: secreto de firma de tokens (`mix phx.gen.secret`).
# SECRET_KEY_BASE=
# PHX_HOST=api.ejemplo.pe
# SIGMA_BASE_URL=https://sigma.upla.edu.pe/api
